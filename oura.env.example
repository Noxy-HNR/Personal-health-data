# Personal Health MCP configuration
# Copy this file to oura.env on first run. The launcher does this automatically.

# Oura OAuth application credentials
OURA_CLIENT_ID=PASTE_YOUR_OURA_CLIENT_ID_HERE
OURA_CLIENT_SECRET=PASTE_YOUR_OURA_CLIENT_SECRET_HERE

# Must exactly match one of the Redirect URIs configured in your Oura application.
# Change 8765 if you choose another local port.
OURA_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback

# Oura V2 OAuth scopes. Remove scopes your application was not granted.
OURA_SCOPES=email personal daily heartrate workout tag session spo2Daily

# Local MCP server. Change OURA_PORT to any unused local port.
# Do not use a port already occupied by another service.
OURA_HOST=127.0.0.1
OURA_PORT=8765

# Runtime OAuth tokens/state are stored locally and git-ignored.
OURA_TOKEN_FILE=data/tokens.json

# Optional NCBI E-utilities settings for higher PubMed request limits.
# NCBI_EMAIL=
# NCBI_API_KEY=
